# Backend only. Save real values as Supabase Edge Function secrets.
CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
CLOUDFLARE_API_TOKEN=your-account-scoped-stream-api-token
# Optional legacy fallback; owners can now save personal tokens in Settings.
RIOT_API_KEY=your-riot-developer-api-key
# Required for user-managed token storage: base64-encoded random 32 bytes.
# Generate once and preserve it across deployments. Never use this placeholder.
RIOT_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
